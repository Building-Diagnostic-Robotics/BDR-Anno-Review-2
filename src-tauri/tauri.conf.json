{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bdr-anno-review",
  "version": "0.6.1",
  "identifier": "io.bdr.annoreview",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$DOWNLOAD/**",
            "$DOCUMENT/**",
            "$DESKTOP/**",
            "$PUBLIC/**",
            "$TEMP/**"
          ]
        }
      }
    },
    "windows": [
      {
        "title": "bdr-anno-review",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "postRemoveScript": "scripts/deb-postrm.sh"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "scripts/nsis-hooks.nsh"
      }
    },
    "resources": [
      "prompts/suggest_boxes_v1.txt"
    ]
  }
}
